+def _make_jwt(account_id="acct-123"):
+    payload = {openai_oauth.JWT_CLAIM_PATH: {"chatgpt_account_id": account_id}}
+    b64 = base64.urlsafe_b64encode(json.dumps(payload).encode()).decode().rstrip("=")
